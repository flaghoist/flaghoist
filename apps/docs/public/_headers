# Security response headers for docs.flaghoist.dev (Cloudflare Pages reads this from the site root).
# The CSP locks the page to its own origin, with the specific allowances Starlight needs: the
# Cloudflare Web Analytics host, 'unsafe-inline' for its inline theme script, and 'wasm-unsafe-eval'
# plus worker-src blob: for Pagefind search, which compiles WebAssembly and runs a worker. Fonts are
# allowed as data: because they are inlined. Tested with `wrangler pages dev` against a real build,
# including a live search.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
