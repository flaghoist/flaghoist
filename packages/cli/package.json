{
  "name": "flaghoist",
  "version": "0.0.0",
  "description": "Scaffold, deploy, and manage your Flaghoist feature-flag service from the terminal.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "flaghoist": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "smol-toml": "^1.7.0"
  },
  "devDependencies": {
    "@flaghoist/adapter-memory": "workspace:*",
    "@flaghoist/core": "workspace:*",
    "@flaghoist/server": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
