{
  "name": "flaghoist",
  "version": "0.1.0",
  "description": "Scaffold, deploy, and manage your Flaghoist feature-flag service from the terminal.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "flaghoist": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/lib.d.ts",
        "default": "./dist/lib.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts src/lib.ts --format esm --dts --clean",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "check:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "smol-toml": "^1.7.1"
  },
  "devDependencies": {
    "@flaghoist/adapter-memory": "workspace:*",
    "@flaghoist/core": "workspace:*",
    "@flaghoist/server": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "openfeature",
    "ofrep",
    "cloudflare-workers",
    "self-hosted",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flaghoist/flaghoist.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/flaghoist/flaghoist#readme",
  "bugs": {
    "url": "https://github.com/flaghoist/flaghoist/issues"
  }
}
