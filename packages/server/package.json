{
  "name": "@flaghoist/server",
  "version": "0.0.0",
  "description": "Hono app factory for Flaghoist: OFREP evaluate, admin CRUD, pluggable auth, and the bundled dashboard.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flaghoist/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
