{
  "name": "@flaghoist/admin-client",
  "version": "0.1.0",
  "description": "HTTP client for the Flaghoist admin API, shared between the CLI, dashboard, and MCP server.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "check:package": "publint --strict && attw --pack ."
  },
  "dependencies": {
    "@flaghoist/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "feature-flags",
    "admin",
    "client",
    "flaghoist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flaghoist/flaghoist.git",
    "directory": "packages/admin-client"
  },
  "homepage": "https://github.com/flaghoist/flaghoist#readme",
  "bugs": {
    "url": "https://github.com/flaghoist/flaghoist/issues"
  }
}
