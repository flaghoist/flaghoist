{
  "name": "@flaghoist/server",
  "version": "0.1.0",
  "description": "Hono app factory for Flaghoist: OFREP evaluate, admin CRUD, and pluggable auth.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./dashboard": {
      "import": {
        "types": "./dist/dashboard.d.ts",
        "default": "./dist/dashboard.js"
      },
      "require": {
        "types": "./dist/dashboard.d.cts",
        "default": "./dist/dashboard.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "dashboard": [
        "./dist/dashboard.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/embed-dashboard.mjs && tsup src/index.ts src/dashboard.ts --format esm,cjs --dts --clean",
    "test": "node scripts/embed-dashboard.mjs && vitest run --passWithNoTests",
    "typecheck": "node scripts/embed-dashboard.mjs && tsc --noEmit",
    "check:package": "publint --strict && attw --pack ."
  },
  "dependencies": {
    "@flaghoist/core": "workspace:*",
    "hono": "^4.13.0",
    "jose": "^6.2.8"
  },
  "devDependencies": {
    "@flaghoist/adapter-memory": "workspace:*",
    "@flaghoist/dashboard": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
