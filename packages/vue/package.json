{
  "name": "@flaghoist/vue",
  "version": "0.1.0",
  "description": "Vue 3 bindings for Flaghoist \u2014 the useFeatureFlag() composable and a pre-wired FlaghoistProvider.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flaghoist/provider-web": "workspace:*"
  },
  "peerDependencies": {
    "@openfeature/web-sdk": "^1.10.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@openfeature/web-sdk": "^1.10.0",
    "vue": "^3.5.41"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "vue",
    "vue3",
    "feature-flags",
    "openfeature",
    "composable",
    "ofrep"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flaghoist/flaghoist.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/flaghoist/flaghoist#readme",
  "bugs": {
    "url": "https://github.com/flaghoist/flaghoist/issues"
  }
}
