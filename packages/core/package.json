{
  "name": "@flaghoist/core",
  "version": "0.1.2",
  "description": "Flag schema, evaluation engine, and storage/auth interfaces for Flaghoist. Zero dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "check:package": "publint --strict && attw --pack ."
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "evaluation",
    "targeting",
    "percentage-rollout"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flaghoist/flaghoist.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/flaghoist/flaghoist#readme",
  "bugs": {
    "url": "https://github.com/flaghoist/flaghoist/issues"
  }
}
